{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.py\"",
            "timeout": 30,
            "statusMessage": "Reading project state..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(git -C:*)",
      "Bash(gh-axi:*)",
      "Bash(gh:*)",
      "Bash(no-mistakes:*)",
      "Bash(tasks-axi:*)",
      "Bash(orca:*)"
    ]
  }
}
